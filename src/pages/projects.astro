---
import Project from '../components/Project.astro';
import LastPlayedLine from '../components/footer/LastPlayedLine.astro';
import GitHubContributions from '../components/footer/GitHubContributions.astro';
import LastPlayed from '../components/footer/LastPlayed.astro';
import { Navbar } from '../components/Navbar';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<Navbar client:load currentPage="projects" transition:persist transition:name="navbar" />
	<div class="min-h-screen flex flex-col">
		<div class="mt-28 flex-1">
			<Project />
		</div>
		<section class="w-full max-w-2xl mx-auto px-4 mt-4 pb-8 stagger-in" style="animation-delay: 200ms;">
			{/* Hidden for now — GitHub contributions + last played
			// <div class="grid grid-cols-1 sm:grid-cols-[1fr_180px] gap-3 mt-3">
			// 	<GitHubContributions />
			// </div>
			*/}
			<div class="flex items-center justify-between gap-4 mt-8">
				<LastPlayedLine />
				<p class="text-muted text-xs shrink-0">&copy; 2026 Phuong. All rights reserved.</p>
			</div>
		</section>
	</div>
</Layout>
