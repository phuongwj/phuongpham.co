---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
		<meta name="description" content="Phuong Pham — Software Engineer" />
		<title>Phuong Pham - Software Engineer</title>
		<script is:inline>
			(function() {
				function isDark() {
					const theme = localStorage.getItem('theme');
					return theme === 'dark' ||
						(!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
				}
				function applyTheme(root) {
					root.classList.toggle('dark', isDark());
					root.style.colorScheme = isDark() ? 'dark' : 'light';
				}
				applyTheme(document.documentElement);

				// paint the incoming document before it is swapped in, otherwise the
				// unthemed <html> lands on screen for a frame and flashes white
				document.addEventListener('astro:before-swap', (e) => {
					applyTheme(e.newDocument.documentElement);
				});
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
