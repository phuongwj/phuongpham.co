---
import { IoLogoGithub } from "react-icons/io";
import { FaLinkedin } from "react-icons/fa";
import { IoIosMail } from "react-icons/io";
---

<section id="home" class="max-w-2xl mx-auto mt-32 px-4 stagger-in">
  <div class="w-[96px] h-[96px] rounded-xl overflow-hidden">
    <img
      src="/avatar.jpg"
      alt="Phuong Pham"
      class="w-full h-full object-cover block"
    />
  </div>

  <h1 class="text-heading text-xl font-medium leading-snug mt-5" style="letter-spacing: -0.01em;">
    Phuong Pham
  </h1>
</section>

<section class="max-w-2xl mx-auto px-4 mt-4 stagger-in hero-intro" style="animation-delay: 60ms;">
  <p class="text-body text-[15px] leading-[1.6]">
    4th year Computer Science student @ <a href="https://www.dal.ca/" target="_blank">Dalhousie University</a><br />
    Incoming Infrastructure Intern @ <a href="https://www.reeldata.ai/" target="_blank">ReelData AI</a>
  </p>

  <p class="text-body text-[15px] leading-[1.7] mt-4">
    I love building projects to learn how different architectures solve
    real-world problems. I'm especially interested in understanding how things
    work under the hood and why certain design decisions make sense for a given
    problem.
  </p>

  <p class="text-body text-[15px] leading-[1.7] mt-4">
    I'm always down to meet new people, hear about what they're working on, or
    just talk about something interesting. Feel free to say hi on
    <a href="https://www.linkedin.com/in/phuongwj/" target="_blank" class="inline-link"><FaLinkedin className="inline-icon" /><span>LinkedIn</span></a>,
    send me an <span class="email-wrap relative inline-block"><button
      id="copy-email"
      type="button"
      class="inline-link"
      data-email="phuong.pham@dal.ca"
    ><IoIosMail className="inline-icon" /><span>email</span></button><span class="email-tip" aria-hidden="true">Copy Email</span></span>,
    or check out my work on <a href="https://github.com/phuongwj" target="_blank" class="inline-link"><IoLogoGithub className="inline-icon" /><span>GitHub</span></a>.
  </p>
</section>

<style>
  .hero-intro a {
    color: var(--c-heading);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .hero-intro a:hover {
    color: var(--c-active-text);
  }

  /* links that carry an icon: keep the glyph out of the underline */
  .hero-intro .inline-link {
    text-decoration: none;
    white-space: nowrap;
  }
  .hero-intro .inline-link :global(.inline-icon) {
    display: inline-block;
    width: 14px;
    height: 14px;
    margin-right: 4px;
    vertical-align: -2px;
  }
  .hero-intro .inline-link span {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  /* the email link is a button, so it needs the anchor styling reset onto it */
  .hero-intro button.inline-link {
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    color: var(--c-heading);
    cursor: pointer;
    transition: color 180ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .hero-intro button.inline-link:hover {
    color: var(--c-active-text);
  }

  .email-tip {
    position: absolute;
    bottom: calc(100% + 4px);
    left: 50%;
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
    pointer-events: none;
    color: var(--c-tooltip);
    background: var(--c-nav-active);
    opacity: 0;
    transform: translateX(-50%) translateY(3px);
    transition: opacity 150ms cubic-bezier(0.23, 1, 0.32, 1),
                transform 150ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  /* downward caret tying the tooltip to the word below it */
  .email-tip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    margin-left: -4px;
    border: 4px solid transparent;
    border-top-color: var(--c-nav-active);
  }

  /* shown on hover, or forced open for a beat after a successful copy */
  .email-wrap:hover .email-tip,
  .email-wrap.copied .email-tip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  @media (hover: none) {
    .email-wrap:hover .email-tip {
      opacity: 0;
    }
    .email-wrap.copied .email-tip {
      opacity: 1;
    }
  }
</style>

<script>
  const btn = document.getElementById('copy-email');
  const wrap = btn?.closest('.email-wrap');
  const tip = wrap?.querySelector('.email-tip');

  if (btn && wrap && tip) {
    let timer: ReturnType<typeof setTimeout>;

    btn.addEventListener('click', async () => {
      const email = btn.dataset.email;
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);
      } catch {
        // clipboard blocked (insecure context, denied permission) — fall back
        window.location.href = `mailto:${email}`;
        return;
      }

      clearTimeout(timer);
      tip.textContent = 'Email Copied!';
      wrap.classList.add('copied');

      timer = setTimeout(() => {
        wrap.classList.remove('copied');
        // wait for the fade-out before restoring the hover label
        setTimeout(() => { tip.textContent = 'Copy Email'; }, 150);
      }, 1500);
    });
  }
</script>
