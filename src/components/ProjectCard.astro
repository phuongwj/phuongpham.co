---
import { projects } from '../utils/data';

const initialsMap: Record<string, string> = {
  "My Turn": "MT",
  "Women in Technology Society Bulletin Board": "WB",
  "Medical AI Assistant": "MA",
  "Dalhousie Syllabus Database": "SD",
};

const reversed = [...projects].reverse();
---

<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 stagger-in">
  {reversed.map((project) => (
    <a
      href={project.github}
      target="_blank"
      class="project-card rounded-2xl border p-4 flex flex-col"
    >
      <div
        class="project-thumb rounded-xl aspect-[4/3] flex items-center justify-center mb-4"
        data-project={project.name}
      >
        <span
          class="project-initials text-2xl font-semibold select-none"
          data-project={project.name}
        >
          {initialsMap[project.name]}
        </span>
      </div>

      <p class="project-title font-semibold text-[13.5px] leading-snug">
        {project.name}
      </p>
      <p class="project-desc text-[12.5px] leading-snug mt-1">
        {project.description}
      </p>
    </a>
  ))}
</div>

<style>
  .project-card {
    border-color: var(--c-border);
    background: var(--c-card);
    text-decoration: none;
    transition: border-color 200ms cubic-bezier(0.23, 1, 0.32, 1),
                box-shadow 200ms cubic-bezier(0.23, 1, 0.32, 1),
                transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .project-card:hover {
      border-color: var(--c-border-hover);
      box-shadow: var(--c-card-lift);
      transform: translateY(-1px);
    }
  }

  .project-card:active { transform: scale(0.995); }

  .project-title { color: var(--c-heading); }
  .project-desc { color: var(--c-muted); }

  /* the thumb is a quiet inset panel; colour comes from the mark, not the field */
  .project-thumb { background: var(--c-surface-alt); }

  .project-initials[data-project="My Turn"] { color: oklch(0.7 0.09 290); }
  .project-initials[data-project="Women in Technology Society Bulletin Board"] { color: oklch(0.68 0.1 130); }
  .project-initials[data-project="Medical AI Assistant"] { color: oklch(0.72 0.1 60); }
  .project-initials[data-project="Dalhousie Syllabus Database"] { color: oklch(0.66 0.09 250); }

  :global(.dark) .project-initials[data-project="My Turn"] { color: oklch(0.62 0.1 290); }
  :global(.dark) .project-initials[data-project="Women in Technology Society Bulletin Board"] { color: oklch(0.6 0.11 130); }
  :global(.dark) .project-initials[data-project="Medical AI Assistant"] { color: oklch(0.64 0.11 60); }
  :global(.dark) .project-initials[data-project="Dalhousie Syllabus Database"] { color: oklch(0.58 0.1 250); }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover { transform: none; }
  }
</style>
